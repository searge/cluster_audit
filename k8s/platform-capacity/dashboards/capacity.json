      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "capacity-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT namespace, mem_req_gb, mem_max_gb, mem_req_gb - mem_max_gb AS mem_unused_gb FROM namespace_trend WHERE taken_at = (SELECT max(taken_at) FROM namespace_trend) ORDER BY mem_unused_gb DESC LIMIT 25"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Bursty namespaces \u2014 safe to cut?",
      "description": "The counterweight to the tables above. A namespace here looks cheap at p95 but occasionally needs far more, so cutting its request down to p95 would throttle it exactly when it is working hardest. Read this before acting on anything in the reserved-but-unused lists, and treat a high ratio as a reason to size on the peak instead.\n\nFull explanation: apps/platform-capacity/dashboard.md in the ovh-cluster repo.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
