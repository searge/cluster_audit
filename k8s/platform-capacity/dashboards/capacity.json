      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "capacity-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH latest AS (SELECT max(taken_at) AS t FROM namespace_trend), previous AS (SELECT max(taken_at) AS t FROM namespace_trend              WHERE taken_at::date < (SELECT t FROM latest)::date) SELECT n.namespace, p.cpu_req_cores AS before_cores, n.cpu_req_cores AS after_cores, n.cpu_req_cores - p.cpu_req_cores AS delta_cores FROM namespace_trend n JOIN namespace_trend p ON p.namespace = n.namespace  AND p.taken_at = (SELECT t FROM previous) WHERE n.taken_at = (SELECT t FROM latest) AND abs(n.cpu_req_cores - p.cpu_req_cores) > 0.05 ORDER BY delta_cores DESC LIMIT 15"
        }
      ]
