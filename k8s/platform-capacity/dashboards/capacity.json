    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reserved but never used",
      "description": "Euro per month for CPU that is reserved and never reaches p95. A rate applied to a reservation, not an invoice: it prices a reserved core at what a core costs on the monthly node pool. Rounded down.\n\nFull explanation: apps/platform-capacity/dashboard.md in the ovh-cluster repo.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "capacity-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#E02F44"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "capacity-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT wasted_eur_month FROM cluster_trend ORDER BY taken_at DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Storage nobody mounts",
      "description": "Block storage claimed by namespaces where no pod mounts it. Billed from the moment a claim is Bound, so an archived project keeps paying for volumes indefinitely. Unlike the CPU figure this is close to an actual cost: a volume belongs to one namespace and needs no allocation.\n\nFull explanation: apps/platform-capacity/dashboard.md in the ovh-cluster repo.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "capacity-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#C97A1A"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "capacity-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT floor(sum(storage_unmounted_gib) * max(eur_per_gib_month)) FROM namespace_trend WHERE taken_at = (SELECT max(taken_at) FROM namespace_trend)"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Rented to fit the rest",
      "description": "Euro per month for the hourly node pool. Those nodes exist because the monthly ones are full: nothing is deliberately placed there, workloads land on them when the scheduler cannot fit them anywhere else. The figure tracks how much did not fit, so unlike the others it falls on the next invoice rather than at some later step.\n\nCharged at a full month of hours, which overstates a pool that spends part of the month scaled down. Treat it as a ceiling.\n\nFull explanation: apps/platform-capacity/dashboard.md in the ovh-cluster repo.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "capacity-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF9830"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "capacity-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT overflow_bill_eur_month FROM cluster_trend WHERE overflow_bill_eur_month IS NOT NULL ORDER BY taken_at DESC LIMIT 1"
        }
      ]
    },
