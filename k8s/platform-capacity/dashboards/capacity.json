      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "capacity-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT namespace, cpu_p95_cores, cpu_max_cores, cpu_max_cores / NULLIF(cpu_p95_cores, 0) AS burst_ratio FROM namespace_trend WHERE taken_at = (SELECT max(taken_at) FROM namespace_trend) AND cpu_max_cores > 0.5 AND cpu_p95_cores > 0.01 ORDER BY burst_ratio DESC LIMIT 15"
        }
