{
  "uid": "mks-capacity",
  "title": "OVH MKS \u2014 capacity",
  "description": "Reserved (resources.requests) vs actually used. The scheduler counts the reservation, not the usage \u2014 reserved-but-unused capacity buys nodes even on an idle cluster. CI namespaces burst by design; kube-system is platform overhead. Weekly samples: CPU p95, memory peak.",
  "tags": [
    "mks",
    "capacity"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "capacity-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
